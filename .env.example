# Copy this file to ".env" (same folder) and paste your keys after the "=".
# .env is git-ignored, so your keys never get committed.

DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

# Optional ---------------------------------------------------------------
# Speech language for Deepgram Nova-3: en, en-US, en-GB, ... or "multi" for mixed languages.
DEEPGRAM_LANGUAGE=en
# Claude model used for cleanup.
CLAUDE_MODEL=claude-haiku-5-5
# Part of a microphone's name to always use it (e.g. "Logi" for the USB headset).
# Leave empty to use the Windows default microphone.
MIC_NAME=
# Keep the mic open while Sayso runs so recording starts instantly (audio is only
# sent while you hold the hotkey). Set to false to open the mic per dictation instead;
# that adds ~0.3-0.9 s before recording starts.
MIC_ALWAYS_ON=true
